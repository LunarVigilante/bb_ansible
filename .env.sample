# =============================================================================
# Blackbeard Media — Headless Deployment Environment Variables
# =============================================================================
# Usage:
#   Download this file: curl -sO https://raw.githubusercontent.com/LunarVigilante/bb_ansible/main/.env.sample
#   Rename to .env:     mv .env.sample .env
#   Fill out keys:      nano .env
#   Run installer:      curl -sL https://raw.githubusercontent.com/LunarVigilante/bb_ansible/main/install.sh | sudo bash
# =============================================================================

# --- Node Identity (settings.yml) ---
# Node type: share, appbox, baremetal
BB_NODE_TYPE="share"
# Media service: emby, plex, jellyfin, none
BB_MEDIA_SERVICE="emby"
# Node name: e-ab-sm-01 (leave blank to use system hostname)
BB_NODE_NAME=""
# Emby Tier: appbox, basic, skip
BB_EMBY_TIER="basic"
# 10Gbps Networking? true or false
BB_IS_10G_NODE="false"

# --- Globals (accounts.yml) ---
BB_ADMIN_PASSWORD=""
BB_CF_EMAIL="you@example.com"
BB_CF_API_TOKEN=""

# --- Media Servers ---
BB_PLEX_TOKEN=""
BB_EMBY_API_KEY=""
BB_JELLYFIN_API_KEY=""

# --- Edge: Ceph Integration ---
BB_CEPH_DASHBOARD_URL="https://ceph-dashboard.example.com:8443"
BB_CEPH_DASHBOARD_USER="admin"
BB_CEPH_DASHBOARD_PASSWORD=""

# --- Feeder: Arrs Stack ---
BB_SONARR_API_KEY=""
BB_RADARR_API_KEY=""
BB_LIDARR_API_KEY=""
BB_READARR_API_KEY=""
BB_PROWLARR_API_KEY=""
BB_BAZARR_API_KEY=""

# --- Ecosystem Integrations ---
# Server Monitoring (Beszel)
BB_BESZEL_HUB_URL=""
BB_BESZEL_HUB_KEY=""
# CrowdSec
BB_CROWDSEC_ENROLL_KEY=""
BB_CROWDSEC_TRAEFIK_BOUNCER_KEY=""
# Discord Webhooks (Optional)
BB_DISCORD_WEBHOOK_GENERAL=""
BB_DISCORD_WEBHOOK_MEDIA=""

# --- Advanced Services ---
# OpenWebUI (AI Integrations)
BB_OPENWEBUI_POSTGRES_USER="postgres"
BB_OPENWEBUI_POSTGRES_PASSWORD=""
BB_OPENWEBUI_OPENROUTER_API_KEY=""
BB_OPENWEBUI_TAVILY_API_KEY=""
BB_OPENWEBUI_GOOGLE_API_KEY=""
# SSO Core (Authentik)
# Leave secrets blank to have them automatically generated mathematically during bootstrap!
BB_AUTHENTIK_POSTGRESQL_PASSWORD=""
BB_AUTHENTIK_SECRET_KEY=""
