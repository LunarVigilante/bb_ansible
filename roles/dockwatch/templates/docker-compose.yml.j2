# Dockwatch — Managed by Blackbeard Ansible
# Node: {{ node_name }}
# Web UI for Docker container update management and notifications
# Provides web UI for updating containers

services:
  dockwatch:
    image: ghcr.io/notifiarr/dockwatch:{{ dockwatch_version }}
    container_name: dockwatch
    restart: unless-stopped
    cgroup_parent: system.slice
    environment:
      TZ: {{ timezone }}
      PUID: "1000"
      PGID: "1000"
      DOCKER_HOST: "tcp://socket-proxy-dockwatch:2375"
    ports:
      - "{{ dockwatch_port }}:2875/tcp"
    volumes:
      - /opt/dockwatch/data:/data
    labels:
      - "autoheal=true"
      - "traefik.enable=true"
{% if node_type == 'service' %}
      - "traefik.http.routers.dockwatch.rule=Host(`dockwatch.{{ traefik_domains[0].main }}`)"
{% else %}
      - "traefik.http.routers.dockwatch.rule=Host(`dockwatch-{{ node_name }}.{{ traefik_domains[0].main }}`)"
{% endif %}
      - "traefik.http.routers.dockwatch.entrypoints=websecure"
      - "traefik.http.routers.dockwatch.tls=true"
      - "traefik.http.routers.dockwatch.tls.certresolver=letsEncrypt"
      - "traefik.http.routers.dockwatch.middlewares=authentik@file"
      - "traefik.http.services.dockwatch.loadbalancer.server.port=2875"
    healthcheck:
      test: ["CMD-SHELL", "wget --spider -q http://localhost:2875/ || exit 1"]
      interval: 60s
      timeout: 5s
      retries: 3
