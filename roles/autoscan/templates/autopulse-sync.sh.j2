#!/bin/bash
# autopulse-sync.sh
# Managed by Blackbeard Ansible
# Dynamically extracts multi-tenant API keys and updates Autopulse targets.

CONFIG_FILE="/opt/autopulse/config.yml"
TEMP_CONF="/tmp/autopulse_targets.yml"
JQ_SCRIPT='''
import yaml;
import sys;
import json;

# Read existing yaml
with open(sys.argv[1], "r") as f:
    config = yaml.safe_load(f)

# Ensure targets block exists
if "targets" not in config or not isinstance(config["targets"], dict):
    config["targets"] = {}

# Read new targets from stdin (JSON format from bash array)
new_targets = json.loads(sys.stdin.read())

# Keep existing manual/static targets that are NOT auto-generated by this script,
# but drop all old auto-generated ones to handle deleted users cleanly
filtered_targets = {}
for name, data in config["targets"].items():
    if not name.startswith(("plex-user_", "emby-user_", "jellyfin-user_")):
        filtered_targets[name] = data

# Merge new auto-generated targets
filtered_targets.update(new_targets)
config["targets"] = filtered_targets

# Write back
with open(sys.argv[1], "w") as f:
    yaml.dump(config, f, default_flow_style=False, sort_keys=False)
'''

# Ensure config exists
if [ ! -f "$CONFIG_FILE" ]; then
    echo "Autopulse config not found at $CONFIG_FILE"
    exit 1
fi

TARGETS_JSON="{}"
HAS_CHANGES=0

# Helper to add a target to the JSON bucket
add_target() {
    local name="$1"
    local type="$2"
    local url="$3"
    local token="$4"
    TARGETS_JSON=$(echo "$TARGETS_JSON" | jq --arg name "$name" --arg type "$type" --arg url "$url" --arg token "$token" \
        '.[$name] = {"type": $type, "url": $url, "token": $token}')
}

echo "Starting Kronos Multi-Tenant API extraction..."

# 1. Plex
for container in $(docker ps --format "{{"{{"}}.Names{{"}}"}}" | grep -E "^plex-user_"); do
    PORT=$(docker port "$container" 32400/tcp | head -n 1 | awk -F':' '{print $2}')
    if [ -z "$PORT" ]; then continue; fi
    
    # Extract config path from volume mounts using docker inspect
    CONFIG_MOUNT=$(docker inspect --format '{{ "{{" }}range .Mounts{{ "}}" }}{{ "{{" }}if eq .Destination "/config"{{ "}}" }}{{ "{{" }}.Source{{ "}}" }}{{ "{{" }}end{{ "}}" }}{{ "{{" }}end{{ "}}" }}' "$container")
    if [ -z "$CONFIG_MOUNT" ]; then continue; fi

    PREFS_FILE="$CONFIG_MOUNT/Library/Application Support/Plex Media Server/Preferences.xml"
    if [ -f "$PREFS_FILE" ]; then
        TOKEN=$(grep -oP 'PlexOnlineToken="\K[^"]+' "$PREFS_FILE")
        if [ -n "$TOKEN" ]; then
            add_target "$container" "plex" "http://127.0.1.1:$PORT" "$TOKEN"
            HAS_CHANGES=1
        fi
    fi
done

# 2. Emby
for container in $(docker ps --format "{{"{{"}}.Names{{"}}"}}" | grep -E "^emby-user_"); do
    PORT=$(docker port "$container" 8096/tcp | head -n 1 | awk -F':' '{print $2}')
    if [ -z "$PORT" ]; then continue; fi

    CONFIG_MOUNT=$(docker inspect --format '{{ "{{" }}range .Mounts{{ "}}" }}{{ "{{" }}if eq .Destination "/config"{{ "}}" }}{{ "{{" }}.Source{{ "}}" }}{{ "{{" }}end{{ "}}" }}{{ "{{" }}end{{ "}}" }}' "$container")
    if [ -z "$CONFIG_MOUNT" ]; then continue; fi

    # Emby stores keys in system.xml
    SYS_FILE="$CONFIG_MOUNT/config/system.xml"
    if [ -f "$SYS_FILE" ]; then
        TOKEN=$(grep -oP '(?<=<Token>)[^<]*' "$SYS_FILE" | head -n 1)
        if [ -n "$TOKEN" ]; then
            add_target "$container" "emby" "http://127.0.1.1:$PORT" "$TOKEN"
            HAS_CHANGES=1
        fi
    fi
done

# 3. Jellyfin
for container in $(docker ps --format "{{"{{"}}.Names{{"}}"}}" | grep -E "^jellyfin-user_"); do
    PORT=$(docker port "$container" 8096/tcp | head -n 1 | awk -F':' '{print $2}')
    if [ -z "$PORT" ]; then continue; fi

    CONFIG_MOUNT=$(docker inspect --format '{{ "{{" }}range .Mounts{{ "}}" }}{{ "{{" }}if eq .Destination "/config"{{ "}}" }}{{ "{{" }}.Source{{ "}}" }}{{ "{{" }}end{{ "}}" }}{{ "{{" }}end{{ "}}" }}' "$container")
    if [ -z "$CONFIG_MOUNT" ]; then continue; fi

    # Jellyfin stores keys in system.xml
    SYS_FILE="$CONFIG_MOUNT/config/system.xml"
    if [ -f "$SYS_FILE" ]; then
        TOKEN=$(grep -oP '(?<=<Token>)[^<]*' "$SYS_FILE" | head -n 1)
        if [ -n "$TOKEN" ]; then
            add_target "$container" "jellyfin" "http://127.0.1.1:$PORT" "$TOKEN"
            HAS_CHANGES=1
        fi
    fi
done

if [ "$HAS_CHANGES" -eq 1 ]; then
    echo "Updating Autopulse configuring mapping..."
    
    # Backup current config
    cp "$CONFIG_FILE" "${CONFIG_FILE}.bak"

    # Merge via python to preserve yaml structure
    echo "$TARGETS_JSON" | python3 -c "$JQ_SCRIPT" "$CONFIG_FILE"

    # Restart autopulse to pick up new targets
    echo "Restarting Autopulse..."
    docker restart autopulse
else
    echo "No valid containers found or no changes made."
fi
