#!/usr/bin/env bash
# =============================================================================
# Blackbeard Gluetun-Plex Watcher
# Automatically restarts dependent Plex containers whenever a Gluetun 
# VPN container restarts, preventing lost network connectivity.
# =============================================================================

echo "Starting Gluetun Watcher. Listening for 'start' and 'die' events..."

# Listen to the native Docker event stream for container starts and deaths
docker events --filter 'event=start' --filter 'event=die' --format '{{"{{"}}.Status{{"}}"}} {{"{{"}}.Actor.Attributes.name{{"}}"}}' | while read -r event_type container_name; do
    # Check if the event involves a Gluetun container
    if [[ "$container_name" == gluetun-* ]]; then
        
        if [[ "$event_type" == "die" ]]; then
            echo "[$(date -Iseconds)] [ALERT] Gluetun container died: $container_name. Autonomous healing initiated..."
            # Force target tunnel to start. This immediately triggers a 'start' event, catching the next logic block.
            docker start "$container_name" 
            
        elif [[ "$event_type" == "start" ]]; then
            echo "[$(date -Iseconds)] Detected Gluetun array online: $container_name"
            
            # Identify any Plex (or other) containers dynamically bound to this specific Gluetun network namespace
            # Network mode format is: container:gluetun-X-Y
            dependent_containers=$(docker ps -a --filter "network=container:$container_name" --format '{{"{{"}}.Names{{"}}"}}')
            
            if [ -n "$dependent_containers" ]; then
                for dependent in $dependent_containers; do
                    echo "[$(date -Iseconds)] Restarting dependent payload to bind to new network interface: $dependent"
                    # Restart the container so it successfully re-attaches to the newly initialized Gluetun network stack
                    docker restart "$dependent"
                done
            else
                echo "[$(date -Iseconds)] No dependent payloads mapped to $container_name"
            fi
        fi
    fi
done
