# Arr Ecosystem — Managed by Blackbeard Ansible
# Node: {{ node_name }}

services:

# === SONARR INSTANCES ===
{% for instance in sonarr_instances | default([]) %}
  {{ instance.name }}:
    image: hotio/sonarr:release
    container_name: {{ instance.name }}
    restart: unless-stopped
    cgroup_parent: kronos.slice
    environment:
      - PUID=1000
      - PGID=1000
      - TZ={{ timezone }}
    volumes:
      - /opt/appdata/{{ instance.name }}:/config
      - /mnt/ceph/media:/mnt/ceph/media
    networks:
      - proxy
{% if instance.port is defined %}
    ports:
      - "{{ instance.port }}:8989"
{% endif %}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.{{ instance.name }}.rule=Host(`{{ node_name }}.{{ instance.name }}.{{ traefik_domains[0].main }}`)"
      - "traefik.http.routers.{{ instance.name }}.entrypoints=websecure"
      - "traefik.http.routers.{{ instance.name }}.tls=true"
      - "traefik.http.routers.{{ instance.name }}.tls.certresolver=letsEncrypt"
      - "traefik.http.services.{{ instance.name }}.loadbalancer.server.port=8989"
      # Opt-out of SSO for API webhook endpoints if needed, but normally Arrs have built-in auth
{% endfor %}

