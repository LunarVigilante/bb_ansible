#!/bin/bash
# BB Ansible — NIC ring buffer optimization
# Auto-detects max supported ring buffer size and applies it.
# Works on both 1G and 10G NICs.

set -euo pipefail

# Detect primary network interface
INTERFACE=$(ip route get 8.8.8.8 | awk 'NR==1 {print $5}')

if [[ -z "${INTERFACE}" ]]; then
    echo "ERROR: Could not detect network interface"
    exit 1
fi

# Get max supported ring buffer sizes
RX_MAX=$(ethtool -g "${INTERFACE}" 2>/dev/null | awk '/^Pre-set maximums/,/^$/ {if (/RX:/) print $2}')
TX_MAX=$(ethtool -g "${INTERFACE}" 2>/dev/null | awk '/^Pre-set maximums/,/^$/ {if (/TX:/) print $2}')

if [[ -z "${RX_MAX}" ]] || [[ -z "${TX_MAX}" ]]; then
    echo "WARNING: Could not read ring buffer limits for ${INTERFACE}, skipping"
    exit 0
fi

echo "Interface: ${INTERFACE}"
echo "Max ring buffers: RX=${RX_MAX} TX=${TX_MAX}"

# Apply max ring buffer sizes
ethtool -G "${INTERFACE}" rx "${RX_MAX}" tx "${TX_MAX}" 2>/dev/null || true

# Verify
CURRENT_RX=$(ethtool -g "${INTERFACE}" 2>/dev/null | awk '/^Current hardware settings/,/^$/ {if (/RX:/) print $2}')
CURRENT_TX=$(ethtool -g "${INTERFACE}" 2>/dev/null | awk '/^Current hardware settings/,/^$/ {if (/TX:/) print $2}')
echo "Applied: RX=${CURRENT_RX} TX=${CURRENT_TX}"
