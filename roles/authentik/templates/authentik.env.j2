PG_PASS={{ vault_authentik_postgresql_password }}
PG_USER=authentik
PG_DB=authentik
AUTHENTIK_SECRET_KEY={{ vault_authentik_secret_key }}

# ═══ Session & Security Hardening ═══
# Cap sessions at 8 hours to prevent indefinite token reuse on shared workstations
AUTHENTIK_SESSION_DURATION=hours=8
# Suppress Sentry error telemetry to prevent internal topology metadata leakage
AUTHENTIK_ERROR_REPORTING__ENABLED=false
# Lock user display name changes to preserve audit trail integrity
AUTHENTIK_DEFAULT_USER_CHANGE_NAME=false

AUTHENTIK_PORT_HTTP={{ authentik_port_http }}
AUTHENTIK_PORT_HTTPS={{ authentik_port_https }}
